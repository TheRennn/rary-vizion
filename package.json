{
  "name": "rary-vizion",
  "version": "0.1.0",
  "private": true,
  "description": "RARY Vizion - The Workspace for Developers",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "supabase:check": "node scripts/check-supabase-migrations.mjs",
    "supabase:local": "node scripts/supabase-local.mjs",
    "supabase:local:configure": "node scripts/configure-local-api-env.mjs",
    "supabase:dev:configure": "node scripts/configure-dev-api-env.mjs",
    "supabase:dev": "node scripts/supabase-dev-remote.mjs",
    "dev:api:project": "node scripts/dev-api-project.mjs",
    "dev:api:local": "node scripts/dev-api-local.mjs",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "supabase": "^3.2.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.33"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
