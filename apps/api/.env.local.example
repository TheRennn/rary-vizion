# Use values printed by `npm run supabase:local -- status` after starting the local stack.
# Never copy credentials from apps/api/.env; this file is for a separate local config.
NODE_ENV=development
SUPABASE_LOCAL=true
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key
SUPABASE_SECRET_KEY=replace-with-local-service-role-key
PORT=3333
DEV_AUTO_LOGIN=false
CORS_ORIGIN=http://localhost:3000
