# Supabase (backend): use a publishable key and a secret/service-role key from Project Settings > API
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

PORT=3333
CORS_ORIGIN="http://localhost:3000"
DEV_AUTO_LOGIN="true"
DEV_DEMO_PASSWORD="Demo@12345"

# Produção exige rate limiter compartilhado (Upstash Redis REST ou compatível)
# RATE_LIMIT_REDIS_URL="https://..."
# RATE_LIMIT_REDIS_TOKEN="..."
# RATE_LIMIT_AUTH_MAX="10"
# RATE_LIMIT_MEETING_MAX="30"
# RATE_LIMIT_DEFAULT_MAX="300"
# TRUST_PROXY="1"
