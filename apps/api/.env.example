# Banco local SQLite (nenhum Docker ou servidor externo)
DATABASE_URL="file:./dev.db"

# Auth - gere um segredo forte: openssl rand -base64 48
JWT_SECRET="troque-este-segredo-por-um-valor-longo-e-aleatorio"
JWT_EXPIRES_IN="8h"

# API
PORT=3333
CORS_ORIGIN="http://localhost:3000"

# Somente desenvolvimento: habilita POST /auth/dev-login (entra como owner@demo.com)
DEV_AUTO_LOGIN="true"
